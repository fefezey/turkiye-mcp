{
  "name": "turkiye-mcp",
  "version": "0.1.0",
  "description": "Türkiye'ye özgü veriler ve hesaplamalar için MCP sunucusu: TCMB döviz kurları, resmi tatiller, iş günü hesabı.",
  "type": "module",
  "bin": {
    "turkiye-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "turkiye",
    "turkey",
    "tcmb",
    "doviz",
    "resmi-tatil"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fast-xml-parser": "^5.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
